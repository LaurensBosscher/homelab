# Agent: Flannel over physical/WAN iface — never Tailscale.
# cluster_network_ip = on-NIC address; cluster_external_ip = public WAN (cluster_wan_ip).
bind-address: {{ cluster_network_ip }}
node-ip: {{ cluster_network_ip }}
node-external-ip: {{ cluster_external_ip | default(cluster_wan_ip | default(cluster_network_ip)) }}

prefer-bundled-bin: true

# Pin the node name to the inventory name so a kubelet hostname change can never
# register a duplicate node (see kubernetes-control-plane/templates/config.yaml.j2).
node-name: {{ inventory_hostname }}

flannel-iface: {{ cluster_network_interface }}

kubelet-arg:
  - "config=/etc/rancher/k3s/kubelet-config.yaml"

# SELinux support (set to true to enable enforcement after policies are installed)
selinux: {{ k3s_selinux_enabled | default(true) | bool | lower }}
