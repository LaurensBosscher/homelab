[Unit]
Description=Beszel Agent (server metrics for the in-cluster Beszel hub)
Wants=network-online.target
After=network-online.target

[Service]
User=beszel
Group=beszel
Environment=PORT={{ beszel_agent_port }}
Environment="KEY={{ beszel_agent_public_key }}"
Environment="TOKEN={{ beszel_agent_token }}"
Environment="HUB_URL={{ beszel_agent_hub_url }}"
{% for item in beszel_agent_extra_env | default({}) | dictsort %}
Environment="{{ item[0] }}={{ item[1] }}"
{% endfor %}
ExecStart=/usr/local/bin/beszel-agent
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
StateDirectory=beszel-agent

[Install]
WantedBy=multi-user.target
