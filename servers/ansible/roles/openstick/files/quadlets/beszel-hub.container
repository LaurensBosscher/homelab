[Container]
Image=docker.io/henrygd/beszel:latest
Environment=APP_URL=https://beszel_openstick.bosscher.ch
Environment=TRUSTED_AUTH_HEADER=Cf-Access-Authenticated-User-Email
Environment=TRUSTED_PROXY_IPS=10.88.0.1
AutoUpdate=registry
PublishPort=8090:8090
Volume=/opt/stack/beszel:/beszel_data
Volume=/bin/busybox:/bin/busybox:ro

HealthCmd=["/bin/busybox","wget","-q","-O","/dev/null","http://127.0.0.1:8090/"]
HealthInterval=60s
HealthRetries=3
HealthTimeout=10s
HealthStartPeriod=60s
HealthOnFailure=kill
HealthOnFailure=kill
[Service]
Environment=NETAVARK_FW=iptables
MemoryMax=250M
RestartSec=5s
LogRateLimitIntervalSec=30
LogRateLimitBurst=300
Restart=always

[Install]
WantedBy=multi-user.target
