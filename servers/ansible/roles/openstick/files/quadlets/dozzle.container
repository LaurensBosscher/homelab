[Container]
Image=docker.io/amir20/dozzle:latest
AutoUpdate=registry
PublishPort=8888:8080
Volume=/run/podman/podman.sock:/var/run/docker.sock:ro
Volume=/bin/busybox:/bin/busybox:ro
Environment=DOZZLE_LEVEL=info
Environment=DOZZLE_NO_ANALYTICS=1
Environment=DOZZLE_AUTH_PROVIDER=forward-proxy
Environment=DOZZLE_AUTH_HEADER_USER=Cf-Access-Authenticated-User-Email
Environment=DOZZLE_AUTH_HEADER_EMAIL=Cf-Access-Authenticated-User-Email
Environment=DOZZLE_AUTH_HEADER_NAME=Cf-Access-Authenticated-User-Email
Environment=DOZZLE_ENABLE_ACTIONS=true
Environment=DOZZLE_ENABLE_SHELL=true

HealthCmd=["/dozzle","healthcheck"]
HealthInterval=60s
HealthRetries=3
HealthTimeout=10s
HealthStartPeriod=60s
HealthOnFailure=kill
[Service]
Environment=NETAVARK_FW=iptables
MemoryMax=200M
RestartSec=5s
LogRateLimitIntervalSec=30
LogRateLimitBurst=300
Restart=always

[Install]
WantedBy=multi-user.target
