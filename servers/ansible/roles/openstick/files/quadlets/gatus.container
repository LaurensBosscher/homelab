[Container]
Image=ghcr.io/twin/gatus:latest
AutoUpdate=registry
PublishPort=8081:8080
Volume=/opt/stack/gatus/config:/config
Volume=/opt/stack/gatus/data:/data
Volume=/bin/busybox:/bin/busybox:ro
Environment=GATUS_CONFIG_PATH=/config/config.yaml

HealthCmd=["/bin/busybox","wget","-q","-O","/dev/null","http://127.0.0.1:8080/"]
HealthInterval=60s
HealthRetries=3
HealthTimeout=10s
HealthStartPeriod=60s
HealthOnFailure=kill
[Service]
MemoryMax=250M
Environment=NETAVARK_FW=iptables
Restart=always

[Install]
WantedBy=multi-user.target
