# Server: Flannel over physical/WAN iface — never Tailscale.
# For bazzite: node-ip=LAN, node-external-ip=cluster_wan_ip (public).
flannel-backend: wireguard-native
flannel-external-ip: true
flannel-iface: {{ cluster_network_interface }}

prefer-bundled-bin: true

node-ip: {{ cluster_network_ip }}
node-external-ip: {{ cluster_external_ip | default(cluster_wan_ip | default(cluster_network_ip)) }}
advertise-address: {{ cluster_network_ip }}

tls-san:
  - {{ cluster_network_ip }}
  - {{ cluster_external_ip | default(cluster_wan_ip | default(cluster_network_ip)) }}
{% if tailscale_ip is defined and tailscale_ip and tailscale_ip != cluster_network_ip %}
  - {{ tailscale_ip }}
{% endif %}
  - {{ inventory_hostname }}

# Disable bundled components (use the managed Prometheus stack for metrics-server)
disable: [traefik, metrics-server]

# Enable secret encryption at rest
secrets-encryption: true

{% if (k3s_datastore | default('sqlite')) == 'etcd' %}
# etcd tunings for high-latency multi-region WAN cluster (V1)
etcd-arg:
  - 'log-level=warn'
  - "heartbeat-interval=500"
  - "election-timeout=5000"
  - "grpc-keepalive-interval=30000"
  - "grpc-keepalive-timeout=20000"
  - "max-request-bytes=10485760"
  - "warning-apply-duration=750000000"
  - "auto-compaction-retention=1h"
  - "auto-compaction-mode=periodic"

etcd-snapshot-schedule-cron: "0 */12 * * *"
etcd-snapshot-retention: 3
{% else %}
# V2 default: embedded SQLite. Do not set etcd-arg / etcd-snapshot-*.
# Back up /var/lib/rancher/k3s/server/db/ + server/token via restic.
{% endif %}

kube-controller-manager-arg:
  - "node-monitor-period=10s"
  - "node-monitor-grace-period=60s"

# Enable SchedulerAsyncAPICalls for higher scheduler throughput (Beta in 1.34+)
kube-scheduler-arg:
  - "feature-gates=SchedulerAsyncAPICalls=true"

kubelet-arg:
  - "config=/etc/rancher/k3s/kubelet-config.yaml"

# SELinux support (set to true to enable enforcement after policies are installed)
selinux: {{ k3s_selinux_enabled | default(true) | bool | lower }}
