{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticPrefixChore"
  ],
  "ignoreUnstable": true,
  "respectLatest": true,
  "enabledManagers": [
    "argocd",
    "dockerfile",
    "kustomize",
    "kubernetes",
    "custom.regex"
  ],
  "dockerfile": {
    "managerFilePatterns": [
      "/(^|/)Dockerfile$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)apps/nzbget/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "image:\\s*lscr\\.io/linuxserver/nzbget:version-v(?<currentValue>\\d+\\.\\d+)"
      ],
      "depNameTemplate": "lscr.io/linuxserver/nzbget",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker",
      "extractVersionTemplate": "^version-v(?<version>\\d+\\.\\d+)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)apps/bookshelf/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "image:\\s*ghcr\\.io/pennydreadful/bookshelf:hardcover-v(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "ghcr.io/pennydreadful/bookshelf",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker",
      "extractVersionTemplate": "^hardcover-v(?<version>\\d+\\.\\d+\\.\\d+)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)apps/listenarr/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "image:\\s*ghcr\\.io/listenarrs/listenarr:canary-(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "ghcr.io/listenarrs/listenarr",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker",
      "extractVersionTemplate": "^canary-(?<version>\\d+\\.\\d+\\.\\d+)$"
    }
  ],
  "argocd": {
    "managerFilePatterns": [
      "/(^|/)apps/.+\\.ya?ml$/"
    ]
  },
  "kustomize": {
    "managerFilePatterns": [
      "/(^|/)apps/.+\\.ya?ml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/(^|/)apps/.+\\.ya?ml$/"
    ]
  },
  "packageRules": [
    {
      "matchManagers": [
        "kubernetes",
        "argocd",
        "kustomize",
        "custom.regex"
      ],
      "matchDatasources": [
        "docker"
      ],
      "automerge": false,
      "prCreation": "immediate",
      "groupName": "container image updates"
    },
    {
      "matchPackageNames": [
        "getmeili/meilisearch"
      ],
      "enabled": false,
      "description": "Meilisearch needs to be updated manually"
    },
    {
      "matchPackageNames": [
        "lscr.io/linuxserver/qbittorrent"
      ],
      "allowedVersions": "/^v?[0-9]\\./",
      "description": "Legacy linuxserver tags such as 20.04.1 sort above qBittorrent 5.x"
    }
  ]
}


